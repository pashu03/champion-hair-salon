# Champion Hair Salon - Environment Configuration

# Local development database
DATABASE_URL="file:./dev.db"

# Vercel automatically selects PostgreSQL. Outside Vercel, replace DATABASE_URL
# with the remote connection string and uncomment this only for production tasks:
# PRISMA_SCHEMA_PROVIDER="postgresql"
# Vercel Postgres integrations may expose POSTGRES_PRISMA_URL or POSTGRES_URL;
# the application automatically recognizes those aliases as well.
# For Supabase on Vercel:
# DATABASE_URL="Supavisor transaction pooler URL (port 6543)"
# DIRECT_URL="Direct or Supavisor session URL (port 5432) for migrations"
# Set to 1 only when you created the complete schema manually with the supplied
# Supabase SQL script instead of allowing Prisma migrations to create it.
# DATABASE_SCHEMA_MANAGED_EXTERNALLY="1"

# Admin Authentication Secret
JWT_SECRET="replace-with-a-long-random-secret"

# Used only by `npm run db:seed`; choose unique production credentials.
ADMIN_EMAIL="admin@championhairsalon.com"
ADMIN_PASSWORD=""

# Next Public Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Salon WhatsApp Number (for click-to-chat links, format: Country code without + followed by digits)
NEXT_PUBLIC_WHATSAPP_NUMBER="918888857057"
NEXT_PUBLIC_PHONE_NUMBER="+91 8888857057"

# Image Upload (Optional Cloudinary Configuration)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
